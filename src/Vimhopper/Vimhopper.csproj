<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Rhino 8 (8.17) 런타임은 .NET 7. Rhino 9(.NET 10)는 추후 TargetFrameworks에 추가 -->
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TargetExt>.gha</TargetExt>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Grasshopper/RhinoCommon NuGet은 net48 자산만 제공하지만 Rhino 8 .NET 런타임에서 그대로 동작 -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <!-- SDK는 기본으로 git 커밋 해시를 InformationalVersion과 SourceLink에 넣는다. 그러면 커밋·체크아웃만 해도
         로더가 다시 빌드되어 (Rhino가 잠그고 있는) .gha 복사가 실패하므로, 로더에서는 끈다 -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="8.17.25066.7001" ExcludeAssets="runtime" />
  </ItemGroup>

  <!--
    로더는 엔진을 리플렉션으로만 부른다. 컴파일 참조를 걸면 엔진 수정 때마다 .gha가 다시 빌드되어
    (Rhino가 잠그고 있는) .gha 복사가 실패하고, 엔진이 기본 컨텍스트에 올라가 언로드할 수 없게 된다.
    여기서는 빌드 순서만 맞춘다. 엔진은 OutDir 설정으로 이 프로젝트의 출력 폴더에 직접 빌드된다.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Vimhopper.Engine\Vimhopper.Engine.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
